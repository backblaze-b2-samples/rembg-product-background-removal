# Backblaze B2 (S3-compatible) — required
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your_region

# Optional: public/CDN base URL for objects. Leave empty to serve everything
# through presigned URLs (the default). Do NOT include a trailing slash.
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=K000-example-not-a-real-application-key
# B2_BUCKET_NAME=my-product-images
# B2_REGION=us-west-004

# --- rembg background-removal engine (optional overrides) ---
# Default model when a product doesn't pin one:
#   u2net | u2netp | isnet-general-use | u2net_human_seg | silueta
# REMBG_DEFAULT_MODEL=u2net
# onnxruntime execution providers (comma-separated). Empty = autodetect
# (CUDA if available, else CPU). Apple CoreML/MPS is opt-in only:
# REMBG_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
